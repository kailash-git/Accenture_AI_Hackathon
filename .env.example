# Copy to .env and fill in. api_server.py reads this on startup.
# The chat endpoint uses GROQ_API_KEY if set, otherwise ANTHROPIC_API_KEY.

# Groq free tier -- https://console.groq.com/keys
GROQ_API_KEY=

# Optional: override the Groq model (default: openai/gpt-oss-120b)
# GROQ_MODEL=llama-3.3-70b-versatile

# Fallback provider (only used if GROQ_API_KEY is unset)
# ANTHROPIC_API_KEY=
