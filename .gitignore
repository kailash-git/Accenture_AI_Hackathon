# --- secrets (never commit) ---
.env
*.env
!.env.example

# --- python ---
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/

# --- logs & scratch ---
*.log
tmp_*.json
test_write.txt

# --- OS ---
.DS_Store
Thumbs.db

# --- editor / tooling local state ---
.claude/
.vscode/
.idea/

# --- evidence graph ---
# The pre-built graph at Accenture/Accenture/data/evidence_graph.gpickle IS committed
# so a clone with only `pip install networkx` is turn-key. Any OTHER .gpickle
# (scratch rebuilds elsewhere) stays ignored.
*.gpickle
!Accenture/Accenture/data/evidence_graph.gpickle
